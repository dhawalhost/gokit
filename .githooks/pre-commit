#!/usr/bin/env bash
set -euo pipefail

echo "[pre-commit] Running gofmt..."
gofmt -w .

ROOT_DIR="$(git rev-parse --show-toplevel)"
MODULES=(. ./x ./database ./outbox ./storage/s3 ./eventbus/kafka ./eventbus/rabbitmq)

echo "[pre-commit] Running golangci-lint..."
for m in "${MODULES[@]}"; do
  echo "  -> $m"
  (cd "$ROOT_DIR/$m" && go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest run --config="$ROOT_DIR/.golangci.yml" --tests=false --timeout=15m ./...)
done

echo "[pre-commit] OK"
